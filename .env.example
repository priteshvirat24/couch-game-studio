# Copy to .env (or set in your hosting environment). All optional.

PORT=8787
# Public HTTPS address phones should use (e.g. your tunnel or domain). Auto-detected if unset.
PUBLIC_URL=
# Where games, drawings and the emoji cache are stored.
DATA_DIR=./data

# AI game design on Amazon Bedrock (standard AWS credentials: env, profile or role).
# Region defaults to your AWS profile's Region.
AWS_REGION=eu-north-1
# Models for the Game Director on Bedrock Mantle (OpenAI-compatible endpoint), tried in order.
BEDROCK_MANTLE_MODELS=qwen.qwen3-235b-a22b-2507,moonshotai.kimi-k2.5
# Model or inference profile for the Bedrock Converse API path. Leave empty for the built-in default.
BEDROCK_MODEL_ID=
# Spending guard: Bedrock designs per day before the offline designer takes over.
BEDROCK_DAILY_LIMIT=150
# auto = Game Director on Mantle -> Game Director on Converse -> one Converse call -> offline designer
# mantle | agent | converse | offline force a single designer
LLM_PROVIDER=auto
LLM_TIMEOUT_MS=60000

# Robot playtesting of every new game (on/off)
PLAYTEST=on
# Make/remix requests allowed per minute per device
CREATE_PER_MINUTE=8
